# Copy this file to .env. Never commit the filled-in .env file.
# cp .env.example .env

# Required for product/article text generation.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Configure one or both bots. Services are enabled with Docker Compose
# profiles, so an empty token is fine for a bot you do not run.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# Generate a real value; do not reuse this placeholder:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace-with-a-generated-fernet-key

# Local (non-Docker) defaults. Docker Compose overrides DATABASE_URL and
# REDIS_URL inside containers to point to its postgres/redis services.
DATABASE_URL=sqlite:///authomatical.db
REDIS_URL=redis://localhost:6379/0
# Redis temporary article hashes expire after this many seconds; PostgreSQL
# remains the durable source of truth for jobs, attempts and results.
ARTICLE_TEMP_TTL_SECONDS=86400

# Use a URL-safe password (letters/numbers recommended) because Compose uses
# it to construct PostgreSQL's connection URL.
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Optional: required only if you enable ImageService / 9Router image flow.
NINEROUTER_API_KEY=
NINEROUTER_MODEL=code-9router-combo

# AI/site resilience settings (seconds / count).
MAX_RETRIES=2
TIMEOUT=120

# Bot transport settings. These are separate from TIMEOUT because PTB's
# default HTTP connect timeout is only five seconds. BOT_POLL_READ_TIMEOUT
# must remain greater than BOT_POLL_TIMEOUT for long polling.
BOT_CONNECT_TIMEOUT=30
BOT_READ_TIMEOUT=30
BOT_WRITE_TIMEOUT=30
BOT_POOL_TIMEOUT=10
BOT_POLL_TIMEOUT=30
BOT_POLL_READ_TIMEOUT=45
BOT_POLL_INTERVAL=1

# Optional: only after copying docker-compose.dns.example.yml to
# docker-compose.override.yml when Docker Desktop cannot resolve external
# hosts. Use DNS servers approved by your network.
# DOCKER_DNS_PRIMARY=1.1.1.1
# DOCKER_DNS_SECONDARY=8.8.8.8
